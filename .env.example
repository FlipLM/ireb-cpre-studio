# Supabase (autenticação e banco PostgreSQL na nuvem)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_ou_publishable

# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo Gemini desejado (opcional; padrão: gemini-3.5-flash-lite com fallback automático)
GEMINI_MODEL=gemini-3.5-flash-lite
